<Window Icon="/Assets/island.ico" x:Class="Island.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.set.title}" Width="820" Height="620" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="#FF1B1B1D" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Margin" Value="2,20,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Background="#0DFFFFFF">
            <StackPanel Margin="12,20,12,12">
                <StackPanel Orientation="Horizontal" Margin="10,0,0,18">
                    <Border Width="34" Height="14" CornerRadius="7" Background="White" VerticalAlignment="Center"/>
                    <TextBlock Text="Island" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="0" Checked="Nav_Checked" IsChecked="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource L.set.nav.look}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="1" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource L.set.nav.notify}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="2" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource L.set.nav.behavior}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="3" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE720;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource L.t.assistant}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="4" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource L.set.nav.privacy}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,24,32,32" MaxWidth="640" HorizontalAlignment="Left">

                <!-- ============ APARÊNCIA ============ -->
                <StackPanel x:Name="PageLook">
                    <TextBlock Style="{StaticResource H1}" Text="{DynamicResource L.set.nav.look}"/>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.language}"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" GroupName="lang" Content="Português" IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=pt}"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="lang" Content="English" IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=en}"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="lang" Content="Español" IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=es}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.languageHint}"/>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.shape}"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" GroupName="shape" IsChecked="{Binding Shape, Converter={StaticResource Eq}, ConverterParameter=pill}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="26" Height="10" CornerRadius="5" Background="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource L.set.pill}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Chip}" GroupName="shape" IsChecked="{Binding Shape, Converter={StaticResource Eq}, ConverterParameter=ball}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Fill="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource L.set.ball}"/>
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.size}"/>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding Scale}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:P0}}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.position}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,4"
                                       Text="{DynamicResource L.set.positionHint}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LockPosition}" Content="{DynamicResource L.set.lockPosition}"/>
                            <Button Style="{StaticResource TextBtn}" Content="{DynamicResource L.set.backToTop}" HorizontalAlignment="Left"
                                    Margin="0,4,0,10" FontSize="12" Padding="14,6" Click="ResetPosition_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.content}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowClockWhenIdle}" Content="{DynamicResource L.set.showClock}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowSystemStats}" Content="{DynamicResource L.set.showStats}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ AVISOS ============ -->
                <StackPanel x:Name="PageNotify" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="{DynamicResource L.set.nav.notify}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.notifyHint}"/>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.kbSound}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyCapsLock}" Content="{DynamicResource L.set.nCaps}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyLanguage}" Content="{DynamicResource L.set.nLang}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyVolume}" Content="{DynamicResource L.set.nVolume}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyAudioDevice}" Content="{DynamicResource L.set.nAudio}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyTrack}" Content="{DynamicResource L.set.nTrack}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.system}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyBrightness}" Content="{DynamicResource L.set.nBright}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyPower}" Content="{DynamicResource L.set.nPower}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyLowBattery}" Content="{DynamicResource L.t.lowBattery}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyNetwork}" Content="{DynamicResource L.set.nNet}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PlaySounds}" Content="{DynamicResource L.set.nSounds}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.toastDuration}"/>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ToastSlider" Minimum="1" Maximum="6" TickFrequency="0.2" IsSnapToTickEnabled="True"
                                    Value="{Binding ToastSeconds}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=ToastSlider, StringFormat={}{0:0.0} s}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ============ COMPORTAMENTO ============ -->
                <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="{DynamicResource L.set.nav.behavior}"/>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ExpandOnHover}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.set.hover}"/>
                                    <TextBlock Style="{StaticResource Sub}" Text="{DynamicResource L.set.hoverHint}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HideInFullscreen}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.set.fullscreen}"/>
                                    <TextBlock Style="{StaticResource Sub}" Text="{DynamicResource L.set.fullscreenHint}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Content="{DynamicResource L.tray.autostart}"
                                      Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource TextBtn}" Content="{DynamicResource L.set.runSetup}" HorizontalAlignment="Left" Margin="0,16,0,0"
                            FontSize="12" Padding="14,7" Click="RunSetup_Click"/>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.upd.title}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CheckUpdates}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.upd.auto}"/>
                                    <TextBlock Style="{StaticResource Sub}" Text="{DynamicResource L.upd.autoHint}"/>
                                </StackPanel>
                            </CheckBox>
                            <TextBlock x:Name="UpdateStatus" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Dim}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="CheckUpdateBtn" Style="{StaticResource TextBtn}" Content="{DynamicResource L.upd.checkNow}"
                                        FontSize="12" Padding="14,7" Click="CheckUpdate_Click"/>
                                <Button x:Name="InstallUpdateBtn" Style="{StaticResource PrimaryBtn}" Margin="10,0,0,0" FontSize="12" Padding="14,7"
                                        Visibility="Collapsed" Click="InstallUpdate_Click"/>
                                <Button x:Name="UpdateNotesBtn" Style="{StaticResource TextBtn}" Content="{DynamicResource L.upd.notes}" Margin="10,0,0,0"
                                        FontSize="12" Padding="14,7" Visibility="Collapsed" Click="UpdateNotes_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ASSISTENTE ============ -->
                <StackPanel x:Name="PageAssistant" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="{DynamicResource L.t.assistant}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{DynamicResource L.set.assistantHint}"/>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.intelligence}"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" GroupName="provider" IsChecked="{Binding Provider, Converter={StaticResource Eq}, ConverterParameter=local}">
                            <StackPanel><TextBlock Text="{DynamicResource L.set.local}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.set.localHint}" FontSize="11" Opacity="0.7"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Chip}" GroupName="provider" IsChecked="{Binding Provider, Converter={StaticResource Eq}, ConverterParameter=claude}">
                            <StackPanel><TextBlock Text="{DynamicResource L.set.claude}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.set.claudeHint}" FontSize="11" Opacity="0.7"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Chip}" GroupName="provider" IsChecked="{Binding Provider, Converter={StaticResource Eq}, ConverterParameter=none}">
                            <StackPanel><TextBlock Text="{DynamicResource L.set.none}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.set.noneHint}" FontSize="11" Opacity="0.7"/></StackPanel>
                        </RadioButton>
                    </WrapPanel>

                    <!-- IA local (Ollama) -->
                    <StackPanel x:Name="LocalOptions">
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock x:Name="OllamaStatus" Text="{DynamicResource L.set.checking}" FontSize="12.5"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{DynamicResource L.set.model}"/>
                                        <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Text="{DynamicResource L.set.modelHint}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkBox}" Padding="10,0" Text="{Binding OllamaModel}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="PullBtn" Style="{StaticResource AccentTextBtn}" Content="{DynamicResource L.set.downloadModel}" FontSize="12" Padding="14,6" Margin="0,0,8,0" Click="PullModel_Click"/>
                                    <Button Style="{StaticResource TextBtn}" Content="{DynamicResource L.set.checkAgain}" FontSize="12" Padding="14,6" Click="CheckOllama_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="PullStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.ollamaUses}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ClaudeOptions">
                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.apiKey}"/>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#1AFFFFFF" CornerRadius="10" Height="34">
                                    <PasswordBox x:Name="KeyBox" Background="Transparent" BorderThickness="0" Foreground="White"
                                                 CaretBrush="White" VerticalContentAlignment="Center" Padding="10,0"
                                                 PasswordChanged="KeyBox_PasswordChanged"/>
                                </Border>
                                <Button Grid.Column="1" Style="{StaticResource TextBtn}" Content="{DynamicResource L.set.test}" Margin="8,0,0,0"
                                        FontSize="12" Padding="16,8" Click="TestKey_Click"/>
                            </Grid>
                            <TextBlock x:Name="KeyStatus" Style="{StaticResource Hint}" Margin="2,8,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.keyStored}"/>
                            <Button Style="{StaticResource TextBtn}" Content="console.anthropic.com" HorizontalAlignment="Left" FontSize="12" Padding="12,5"
                                    Tag="https://console.anthropic.com/settings/keys" Click="OpenLink_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.claudeModel}"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" GroupName="model" IsChecked="{Binding Model, Converter={StaticResource Eq}, ConverterParameter=claude-opus-5-5}">
                            <StackPanel><TextBlock Text="Opus 5.5" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.set.opusHint}" FontSize="11" Opacity="0.7"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Chip}" GroupName="model" IsChecked="{Binding Model, Converter={StaticResource Eq}, ConverterParameter=claude-sonnet-5-5}">
                            <StackPanel><TextBlock Text="Sonnet 5.5" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.set.sonnetHint}" FontSize="11" Opacity="0.7"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Chip}" GroupName="model" IsChecked="{Binding Model, Converter={StaticResource Eq}, ConverterParameter=claude-haiku-5-5}">
                            <StackPanel><TextBlock Text="Haiku 5.5" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.set.haikuHint}" FontSize="11" Opacity="0.7"/></StackPanel>
                        </RadioButton>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.effort}"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" GroupName="effort" Content="{DynamicResource L.set.effortLow}" IsChecked="{Binding Effort, Converter={StaticResource Eq}, ConverterParameter=low}"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="effort" Content="{DynamicResource L.set.effortMedium}" IsChecked="{Binding Effort, Converter={StaticResource Eq}, ConverterParameter=medium}"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="effort" Content="{DynamicResource L.set.effortHigh}" IsChecked="{Binding Effort, Converter={StaticResource Eq}, ConverterParameter=high}"/>
                    </WrapPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.spotify}"/>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock x:Name="SpotifyStatus" FontSize="12.5" TextWrapping="Wrap"/>
                            <StackPanel x:Name="SpotifySetup" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.spIntro}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{DynamicResource L.set.sp1}"/>
                                <Button Style="{StaticResource TextBtn}" Content="{DynamicResource L.set.spOpenDev}" HorizontalAlignment="Left" FontSize="12" Padding="12,5"
                                        Margin="0,2,0,6" Tag="https://developer.spotify.com/dashboard" Click="OpenLink_Click"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{DynamicResource L.set.sp2}"/>
                                <Grid Margin="0,4,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="10,6">
                                        <TextBlock Text="http://127.0.0.1:8977/callback" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                                    </Border>
                                    <Button Grid.Column="1" Style="{StaticResource TextBtn}" Content="{DynamicResource L.set.copy}" FontSize="12" Padding="12,6" Margin="8,0,0,0" Click="CopyRedirect_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,4" Text="{DynamicResource L.set.sp3}"/>
                                <TextBox Style="{StaticResource DarkBox}" Padding="10,0" FontFamily="Cascadia Mono, Consolas" Text="{Binding SpotifyClientId}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="SpotifyConnectBtn" Style="{StaticResource AccentTextBtn}" Content="{DynamicResource L.set.spConnect}" FontSize="12" Padding="14,6" Click="SpotifyConnect_Click"/>
                                <Button x:Name="SpotifyDisconnectBtn" Style="{StaticResource TextBtn}" Content="{DynamicResource L.set.spDisconnect}" FontSize="12" Padding="14,6" Margin="8,0,0,0" Click="SpotifyDisconnect_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.voice}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding VoiceEnabled}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.set.voiceEnabled}"/>
                                    <TextBlock Style="{StaticResource Sub}" Text="{DynamicResource L.set.voiceEnabledHint}"/>
                                </StackPanel>
                            </CheckBox>

                            <TextBlock Text="{DynamicResource L.set.voiceModel}" Margin="0,10,0,6"/>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Chip}" GroupName="voicemodel" IsChecked="{Binding VoiceModel, Converter={StaticResource Eq}, ConverterParameter=base}">
                                    <StackPanel><TextBlock Text="{DynamicResource L.set.effortLow}" FontWeight="SemiBold"/><TextBlock x:Name="BaseModelInfo" Text="57 MB" FontSize="11" Opacity="0.7"/></StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Chip}" GroupName="voicemodel" IsChecked="{Binding VoiceModel, Converter={StaticResource Eq}, ConverterParameter=small}">
                                    <StackPanel><TextBlock Text="{DynamicResource L.set.vmPrecise}" FontWeight="SemiBold"/><TextBlock x:Name="SmallModelInfo" Text="181 MB" FontSize="11" Opacity="0.7"/></StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Chip}" GroupName="voicemodel" IsChecked="{Binding VoiceModel, Converter={StaticResource Eq}, ConverterParameter=turbo}">
                                    <StackPanel><TextBlock Text="{DynamicResource L.set.vmMax}" FontWeight="SemiBold"/><TextBlock x:Name="TurboModelInfo" Text="547 MB" FontSize="11" Opacity="0.7"/></StackPanel>
                                </RadioButton>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="VoiceModelBtn" Style="{StaticResource AccentTextBtn}" Content="{DynamicResource L.set.vmDownload}" FontSize="12" Padding="14,6"
                                        Margin="0,0,10,0" Click="DownloadVoiceModel_Click"/>
                                <TextBlock x:Name="VoiceModelStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0"/>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource L.t.mic}" Margin="0,14,0,2"/>
                            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap"
                                       Text="{DynamicResource L.set.micHint}"/>
                            <WrapPanel x:Name="MicList" Margin="0,8,0,0"/>
                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE720;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Grid Grid.Column="1" Height="6" VerticalAlignment="Center">
                                    <Border Background="#26FFFFFF" CornerRadius="3"/>
                                    <Border x:Name="MicLevel" Background="#FF34C759" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="MicHint" Style="{StaticResource Hint}" Text="{DynamicResource L.set.micLevelHint}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.set.loudOnly}" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding WakeSensitivity}" Margin="10,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource L.set.whisper}" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,8"
                                       Text="{DynamicResource L.set.sensitivityHint}"/>

                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WakeWordEnabled}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.set.wakeEnabled}"/>
                                    <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" MaxWidth="440"
                                               Text="{DynamicResource L.set.wakeEnabledHint}"/>
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="WakeOptions" Margin="0,2,0,8">
                                <TextBlock Text="{DynamicResource L.set.wakeWord}" Margin="0,4,0,6"/>
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="wakename" Content="{DynamicResource L.wake.island}" IsChecked="{Binding WakeName, Converter={StaticResource Eq}, ConverterParameter=island}"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="wakename" Content="{DynamicResource L.wake.ilha}" IsChecked="{Binding WakeName, Converter={StaticResource Eq}, ConverterParameter=ilha}"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="wakename" Content="{DynamicResource L.wake.jarvis}" IsChecked="{Binding WakeName, Converter={StaticResource Eq}, ConverterParameter=jarvis}"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="{DynamicResource L.set.wakeWordHint}"/>

                                <Border Background="#140A84FF" BorderBrush="#400A84FF" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,6,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L.set.train}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,2,0,8"
                                                   Text="{DynamicResource L.set.trainHint}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="TrainBtn" Style="{StaticResource AccentTextBtn}" Content="{DynamicResource L.set.trainStart}" FontSize="12" Padding="14,6" Click="TrainVoice_Click"/>
                                            <Button x:Name="ForgetTrainBtn" Style="{StaticResource TextBtn}" Content="{DynamicResource L.set.trainForget}" FontSize="12" Padding="14,6" Margin="8,0,0,0" Click="ForgetTraining_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TrainStatus" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{DynamicResource L.set.extraPhrases}" Margin="0,4,0,6"/>
                                <TextBox Style="{StaticResource DarkBox}" Padding="10,0" Text="{Binding WakePhrases}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{DynamicResource L.set.extraPhrasesHint}"/>
                                <Border Background="#0FFFFFFF" CornerRadius="8" Padding="10,8" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="WakeStatusLabel" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="WakeHeardLabel" FontSize="11.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SaveVoiceRecordings}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.set.saveRec}"/>
                                    <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" MaxWidth="440"
                                               Text="{DynamicResource L.set.saveRecHint}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SpeakReplies}" Content="{DynamicResource L.set.speak}"/>
                            <TextBlock Text="{DynamicResource L.set.ttsVoice}" Margin="0,4,0,2"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.ttsHint}"/>
                            <WrapPanel x:Name="TtsList" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="TtsPreviewBtn" Style="{StaticResource TextBtn}" Content="{DynamicResource L.set.ttsPreview}" FontSize="12" Padding="14,6" Click="TtsPreview_Click"/>
                                <TextBlock x:Name="TtsStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <Grid Margin="0,8,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource L.set.hotkey}"/>
                                    <TextBlock Style="{StaticResource Sub}" Text="{DynamicResource L.set.hotkeyHint}"/>
                                </StackPanel>
                                <TextBox x:Name="HotkeyBox" Grid.Column="1" Style="{StaticResource DarkBox}" Padding="10,0" IsReadOnly="True"
                                         IsReadOnlyCaretVisible="False" Text="{Binding Hotkey, Mode=OneWay}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.projects}"/>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.set.projectFolders}"/>
                            <TextBox Style="{StaticResource DarkBox}" Padding="10,8" Margin="0,8,0,0" AcceptsReturn="True" MinHeight="74"
                                     VerticalContentAlignment="Top" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                     Text="{Binding ProjectFolders}" x:Name="FoldersBox"/>
                            <Button Style="{StaticResource TextBtn}" Content="{DynamicResource L.set.addFolder}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    FontSize="12" Padding="14,6" Click="AddFolder_Click"/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource L.set.editor}"/>
                                    <TextBlock Style="{StaticResource Sub}" Text="{DynamicResource L.set.editorHint}"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource DarkBox}" Padding="10,0" Text="{Binding PreferredEditor}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.security}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ConfirmCommands}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.set.confirm}"/>
                                    <TextBlock Style="{StaticResource Sub}" Text="{DynamicResource L.set.confirmHint}"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.aboutYou}"/>
                    <TextBox Style="{StaticResource DarkBox}" Padding="10,8" AcceptsReturn="True" MinHeight="74" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Text="{Binding ExtraInstructions}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.aboutYouHint}"/>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.memory}"/>
                    <TextBox x:Name="MemoryBox" Style="{StaticResource DarkBox}" Padding="10,8" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Text="{Binding MemoriesText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.memoryHint}"/>
                </StackPanel>

                <!-- ============ PRIVACIDADE ============ -->
                <StackPanel x:Name="PagePrivacy" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="{DynamicResource L.set.nav.privacy}"/>
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{DynamicResource L.set.privLocal}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.privLocalText}"/>
                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,0" Text="{DynamicResource L.set.privCloud}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.privCloudText}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource TextBtn}" Content="{DynamicResource L.set.openData}" FontSize="12" Padding="14,6" Click="OpenData_Click"/>
                                <Button Style="{StaticResource TextBtn}" Content="{DynamicResource L.set.openLog}" FontSize="12" Padding="14,6" Margin="8,0,0,0" Click="OpenLog_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
