<Window Icon="/Assets/island.ico" x:Class="Island.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.wiz.title}" Width="720" Height="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#FF1B1B1D" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Margin" Value="2,20,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>
        <Style x:Key="Lead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="40,28,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="Dots" Orientation="Horizontal">
            <Border Width="36" Height="5" CornerRadius="3" Margin="0,0,6,0" Background="#33FFFFFF"/>
            <Border Width="36" Height="5" CornerRadius="3" Margin="0,0,6,0" Background="#33FFFFFF"/>
            <Border Width="36" Height="5" CornerRadius="3" Margin="0,0,6,0" Background="#33FFFFFF"/>
            <Border Width="36" Height="5" CornerRadius="3" Margin="0,0,6,0" Background="#33FFFFFF"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,22,0,16" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- 1. Boas-vindas, idioma e PC -->
                <StackPanel x:Name="Step0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="46" Height="18" CornerRadius="9" Background="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="{DynamicResource L.wiz.welcome}"/>
                    <TextBlock Style="{StaticResource Lead}" Text="{DynamicResource L.wiz.welcomeText}"/>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.set.language}"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" GroupName="lang" Content="Português" IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=pt}"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="lang" Content="English" IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=en}"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="lang" Content="Español" IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=es}"/>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Group}" Text="{DynamicResource L.wiz.pc}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="GpuText"/>
                            <TextBlock x:Name="RamText" Margin="0,4,0,0"/>
                            <TextBlock x:Name="RecommendText" Style="{StaticResource Hint}" Margin="0,10,0,0" Foreground="#FF5AA9FF"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2. Voz -->
                <StackPanel x:Name="Step1" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="{DynamicResource L.wiz.voiceTitle}"/>
                    <TextBlock Style="{StaticResource Lead}" Text="{DynamicResource L.wiz.voiceText}"/>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding VoiceEnabled}" Content="{DynamicResource L.set.voiceEnabled}"/>
                            <TextBlock Text="{DynamicResource L.set.voiceModel}" Margin="0,10,0,6"/>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Chip}" GroupName="vm" IsChecked="{Binding VoiceModel, Converter={StaticResource Eq}, ConverterParameter=base}">
                                    <StackPanel><TextBlock Text="{DynamicResource L.set.vmFast}" FontWeight="SemiBold"/><TextBlock Text="57 MB" FontSize="11" Opacity="0.7"/></StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Chip}" GroupName="vm" IsChecked="{Binding VoiceModel, Converter={StaticResource Eq}, ConverterParameter=small}">
                                    <StackPanel><TextBlock Text="{DynamicResource L.set.vmPrecise}" FontWeight="SemiBold"/><TextBlock Text="181 MB" FontSize="11" Opacity="0.7"/></StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Chip}" GroupName="vm" IsChecked="{Binding VoiceModel, Converter={StaticResource Eq}, ConverterParameter=turbo}">
                                    <StackPanel><TextBlock Text="{DynamicResource L.set.vmMax}" FontWeight="SemiBold"/><TextBlock Text="547 MB" FontSize="11" Opacity="0.7"/></StackPanel>
                                </RadioButton>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="VoiceDownloadBtn" Style="{StaticResource AccentTextBtn}" Content="{DynamicResource L.set.vmDownload}" FontSize="12" Padding="14,6"
                                        Margin="0,0,10,0" Click="VoiceDownload_Click"/>
                                <TextBlock x:Name="VoiceStatus" VerticalAlignment="Center" FontSize="12.5"/>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource L.set.mic}" Margin="0,16,0,2"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.micHint}"/>
                            <WrapPanel x:Name="MicList" Margin="0,6,0,0"/>
                            <Grid Margin="0,2,0,2" Height="6">
                                <Border Background="#26FFFFFF" CornerRadius="3"/>
                                <Border x:Name="MicLevel" Background="#FF34C759" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.micLevelHint}"/>

                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WakeWordEnabled}" Margin="0,12,0,4" Content="{DynamicResource L.set.wakeEnabled}"/>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Chip}" GroupName="wake" Content="{DynamicResource L.wake.island}" IsChecked="{Binding WakeName, Converter={StaticResource Eq}, ConverterParameter=island}"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="wake" Content="{DynamicResource L.wake.jarvis}" IsChecked="{Binding WakeName, Converter={StaticResource Eq}, ConverterParameter=jarvis}"/>
                                <RadioButton x:Name="IlhaChip" Style="{StaticResource Chip}" GroupName="wake" Content="{DynamicResource L.wake.ilha}" IsChecked="{Binding WakeName, Converter={StaticResource Eq}, ConverterParameter=ilha}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. Assistente -->
                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="{DynamicResource L.wiz.aiTitle}"/>
                    <TextBlock Style="{StaticResource Lead}" Text="{DynamicResource L.wiz.aiText}"/>

                    <WrapPanel Margin="0,18,0,0">
                        <RadioButton Style="{StaticResource Chip}" GroupName="prov" IsChecked="{Binding Provider, Converter={StaticResource Eq}, ConverterParameter=local}">
                            <StackPanel><TextBlock Text="{DynamicResource L.set.local}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.set.localHint}" FontSize="11" Opacity="0.7"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Chip}" GroupName="prov" IsChecked="{Binding Provider, Converter={StaticResource Eq}, ConverterParameter=claude}">
                            <StackPanel><TextBlock Text="{DynamicResource L.set.claude}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.set.claudeHint}" FontSize="11" Opacity="0.7"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Chip}" GroupName="prov" IsChecked="{Binding Provider, Converter={StaticResource Eq}, ConverterParameter=none}">
                            <StackPanel><TextBlock Text="{DynamicResource L.set.none}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.set.noneHint}" FontSize="11" Opacity="0.7"/></StackPanel>
                        </RadioButton>
                    </WrapPanel>
                    <TextBlock x:Name="AiNote" Style="{StaticResource Hint}" Foreground="#FFFFB020"/>

                    <Border x:Name="LocalPanel" Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="OllamaStatus" TextWrapping="Wrap" FontSize="12.5"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.set.model}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DarkBox}" Padding="10,0" Text="{Binding OllamaModel}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="InstallBtn" Style="{StaticResource AccentTextBtn}" Content="{DynamicResource L.set.installOllama}" FontSize="12" Padding="14,6" Margin="0,0,8,0" Click="Install_Click"/>
                                <Button x:Name="PullBtn" Style="{StaticResource AccentTextBtn}" Content="{DynamicResource L.set.downloadModel}" FontSize="12" Padding="14,6" Margin="0,0,8,0" Click="Pull_Click"/>
                                <Button Style="{StaticResource TextBtn}" Content="{DynamicResource L.set.checkAgain}" FontSize="12" Padding="14,6" Click="Check_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="LocalProgress" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.ollamaUses}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ClaudePanel" Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.set.apiKey}" FontSize="12" Foreground="{StaticResource Dim}"/>
                            <Border Background="#1AFFFFFF" CornerRadius="10" Height="34" Margin="0,8,0,0">
                                <PasswordBox x:Name="KeyBox" Background="Transparent" BorderThickness="0" Foreground="White"
                                             CaretBrush="White" VerticalContentAlignment="Center" Padding="10,0" PasswordChanged="KeyBox_PasswordChanged"/>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L.set.keyStored}"/>
                            <Button Style="{StaticResource TextBtn}" Content="console.anthropic.com" HorizontalAlignment="Left" FontSize="12" Padding="12,5"
                                    Tag="https://console.anthropic.com/settings/keys" Click="OpenLink_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 4. Pronto -->
                <StackPanel x:Name="Step3" Visibility="Collapsed">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="40" Foreground="#FF34C759" Margin="0,0,0,14"/>
                    <TextBlock Style="{StaticResource H1}" Text="{DynamicResource L.wiz.doneTitle}"/>
                    <TextBlock x:Name="DoneText" Style="{StaticResource Lead}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Button x:Name="SkipBtn" Style="{StaticResource TextBtn}" Content="{DynamicResource L.wiz.skip}" HorizontalAlignment="Left" FontSize="13" Padding="18,8" Click="Skip_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackBtn" Style="{StaticResource TextBtn}" Content="{DynamicResource L.wiz.back}" FontSize="13" Padding="18,8" Margin="0,0,8,0" Click="Back_Click"/>
                <Button x:Name="NextBtn" Style="{StaticResource AccentTextBtn}" Content="{DynamicResource L.wiz.next}" FontSize="13" Padding="22,8" Click="Next_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
