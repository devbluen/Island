<Window x:Class="Island.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island" Width="600" Height="420"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="White"/>
    </Window.Resources>

    <Grid x:Name="Root" Width="600" Height="420">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <Grid x:Name="PillHost" Width="120" Height="34" Margin="10"
              HorizontalAlignment="Center" VerticalAlignment="Top" AllowDrop="True"
              SizeChanged="PillHost_SizeChanged" MouseEnter="Pill_MouseEnter" MouseLeftButtonDown="Pill_MouseLeftButtonDown"
              MouseMove="Pill_MouseMove" MouseLeftButtonUp="Pill_MouseLeftButtonUp"
              DragEnter="Pill_DragEnter" DragOver="Pill_DragOver" DragLeave="Pill_DragLeave" Drop="Pill_Drop">

            <Border x:Name="Shadow" Background="Black" CornerRadius="17">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.45"/>
                </Border.Effect>
            </Border>

            <Border x:Name="Pill" Background="Black" CornerRadius="17">
                <Grid>
                    <!-- ===== COMPACTO (pílula) ===== -->
                    <Grid x:Name="CompactView" Margin="6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="6" Background="#33FFFFFF"
                                VerticalAlignment="Center" Visibility="Collapsed">
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush x:Name="CompactArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Border>
                        <TextBlock x:Name="CompactText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <StackPanel x:Name="EqBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,6,0" Visibility="Collapsed">
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                        <TextBlock x:Name="CompactTimer" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="13" FontWeight="SemiBold" Visibility="Collapsed"/>
                    </Grid>

                    <!-- ===== COMPACTO (bolinha) ===== -->
                    <Grid x:Name="BallView" Opacity="0" IsHitTestVisible="False">
                        <Ellipse x:Name="BallRing" Margin="2.5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0"/>
                        <Ellipse x:Name="BallArt" Width="30" Height="30" Visibility="Collapsed">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="BallArtBrush" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="BallText" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ===== AVISO RÁPIDO (toast) ===== -->
                    <Grid x:Name="ToastView" Width="360" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Opacity="0" IsHitTestVisible="False">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ToastIcon" FontFamily="{StaticResource Icons}" FontSize="16"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Border x:Name="ToastArt" Width="26" Height="26" CornerRadius="7" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="ToastArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                                <TextBlock x:Name="ToastTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ToastSub" FontSize="11" Foreground="{StaticResource Dim}"
                                           TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel x:Name="ToastLevel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="100" Height="6" VerticalAlignment="Center">
                                    <Border Background="#33FFFFFF" CornerRadius="3"/>
                                    <Border x:Name="ToastFill" Background="White" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                                <TextBlock x:Name="ToastValue" Width="26" TextAlignment="Right" FontSize="11"
                                           Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ===== EXPANDIDO ===== -->
                    <Grid x:Name="ExpandedView" Width="500" Height="210" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Opacity="0" IsHitTestVisible="False">
                        <Grid Margin="20,12,16,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                                <TextBlock x:Name="ExpClock" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ExpDate" FontSize="12" Foreground="{StaticResource Dim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ExpBattery" FontSize="11.5" Foreground="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ExpStats" FontSize="11" Foreground="{StaticResource Faint}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="TabAssistant" Style="{StaticResource TabBtn}" Content="&#xE720;" Tag="4" Click="Tab_Click"/>
                                <Button x:Name="TabMedia" Style="{StaticResource TabBtn}" Content="&#xE8D6;" Tag="0" Click="Tab_Click"/>
                                <Button x:Name="TabTimer" Style="{StaticResource TabBtn}" Content="&#xE916;" Tag="1" Click="Tab_Click"/>
                                <Button x:Name="TabTodo" Style="{StaticResource TabBtn}" Content="&#xE9D5;" Tag="2" Click="Tab_Click"/>
                                <Button x:Name="TabShelf" Style="{StaticResource TabBtn}" Content="&#xE8B7;" Tag="3" Click="Tab_Click"/>
                                <Button Style="{StaticResource TabBtn}" Content="&#xE713;" Click="Settings_Click"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,10,0,0">

                                <!-- Assistente -->
                                <Grid x:Name="AssistantPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Hidden">
                                        <ItemsControl x:Name="ChatList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="Bubble" HorizontalAlignment="Left" MaxWidth="440" Margin="0,3"
                                                            CornerRadius="12" Padding="2,1" Background="Transparent">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}"
                                                                           FontSize="11" Foreground="#99FFFFFF" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                                                <TextBox x:Name="Body" Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" FontSize="11.5"
                                                                         Foreground="#B3FFFFFF" MaxWidth="400" PreviewMouseDown="Input_PreviewMouseDown"/>
                                                            </StackPanel>
                                                            <TextBox x:Name="Detail" Style="{StaticResource SelectableText}" Text="{Binding Detail, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                                                     Foreground="#80FFFFFF" Margin="19,2,0,0" MaxHeight="64" PreviewMouseDown="Input_PreviewMouseDown"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Detail}" Value="">
                                                            <Setter TargetName="Detail" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Glyph}" Value="">
                                                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="user">
                                                            <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter TargetName="Bubble" Property="Background" Value="#FF0A84FF"/>
                                                            <Setter TargetName="Bubble" Property="Padding" Value="11,6"/>
                                                            <Setter TargetName="Bubble" Property="Margin" Value="40,6,0,3"/>
                                                            <Setter TargetName="Body" Property="Foreground" Value="White"/>
                                                            <Setter TargetName="Body" Property="FontSize" Value="12.5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="assistant">
                                                            <Setter TargetName="Bubble" Property="Background" Value="#1FFFFFFF"/>
                                                            <Setter TargetName="Bubble" Property="Padding" Value="11,6"/>
                                                            <Setter TargetName="Bubble" Property="Margin" Value="0,4,40,6"/>
                                                            <Setter TargetName="Body" Property="Foreground" Value="White"/>
                                                            <Setter TargetName="Body" Property="FontSize" Value="12.5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="error">
                                                            <Setter TargetName="Body" Property="Foreground" Value="#FFFF6B5E"/>
                                                            <Setter TargetName="Glyph" Property="Foreground" Value="#FFFF6B5E"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel x:Name="ChatEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="&#xE720;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource L.chat.emptyTitle}" FontSize="13" Margin="0,10,0,8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource L.chat.ex1}" FontSize="11.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource L.chat.ex2}" FontSize="11.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource L.chat.ex3}" FontSize="11.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="HotkeyHint" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <Border x:Name="ConfirmBar" Grid.Row="1" Visibility="Collapsed" Background="#26FFB020"
                                            BorderBrush="#66FFB020" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="ConfirmTitle" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="ConfirmDetail" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{StaticResource Dim}" MaxHeight="64" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Button Style="{StaticResource TextBtn}" Content="{DynamicResource L.confirm.deny}" FontSize="12" Padding="12,6" Click="ConfirmNo_Click"/>
                                                <Button Style="{StaticResource AccentTextBtn}" Content="{DynamicResource L.confirm.allow}" FontSize="12" Padding="12,6" Margin="6,0,0,0" Click="ConfirmYes_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AskInput" Style="{StaticResource DarkBox}" Padding="10,0"
                                                 PreviewMouseDown="Input_PreviewMouseDown" KeyDown="AskInput_KeyDown" TextChanged="AskInput_TextChanged"/>
                                        <TextBlock x:Name="AskHint" Text="{DynamicResource L.chat.hint}" IsHitTestVisible="False"
                                                   Margin="12,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Faint}"/>
                                        <Button x:Name="MicBtn" Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE720;" Margin="6,0,0,0" Click="Mic_Click"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button x:Name="CopyChatBtn" Style="{StaticResource IconBtn}" Content="&#xE8C8;" FontSize="13" Click="CopyChat_Click"/>
                                            <Button x:Name="ChatActionBtn" Style="{StaticResource IconBtn}" Content="&#xE74D;" FontSize="13" Click="ChatAction_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Mídia -->
                                <Grid x:Name="MediaPanel">
                                    <Grid x:Name="MediaContent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="104" Height="104" CornerRadius="14" Background="#1FFFFFFF" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock x:Name="BigArtGlyph" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="32"
                                                           Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border CornerRadius="14">
                                                    <Border.Background>
                                                        <ImageBrush x:Name="BigArtBrush" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Column="1" Margin="16,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="MediaTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="MediaArtist" Grid.Row="1" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="MediaApp" Grid.Row="2" FontSize="10" Foreground="{StaticResource Faint}" Margin="0,2,0,0"/>

                                            <Grid x:Name="ProgressRow" Grid.Row="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="PosText" FontSize="10" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Text="0:00"/>
                                                <Grid x:Name="SeekTrack" Grid.Column="1" Height="14" Margin="8,0" Background="Transparent"
                                                      Cursor="Hand" MouseLeftButtonDown="Seek_MouseDown">
                                                    <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/>
                                                    <Border x:Name="SeekFill" Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"/>
                                                </Grid>
                                                <TextBlock x:Name="DurText" Grid.Column="2" FontSize="10" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Text="0:00"/>
                                            </Grid>

                                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Click="Prev_Click" Margin="0,0,10,0"/>
                                                <Button x:Name="PlayPauseBtn" Style="{StaticResource PrimaryBtn}" Content="&#xE768;" Click="PlayPause_Click"/>
                                                <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Click="Next_Click" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    <StackPanel x:Name="NoMedia" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource L.media.none}" FontSize="13" Margin="0,10,0,2" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource L.media.noneHint}" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Timer de foco -->
                                <Grid x:Name="TimerPanel" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TimerMode" Text="{DynamicResource L.timer.focus}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock x:Name="TimerBig" Text="25:00" FontSize="54" FontWeight="Light"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI" Margin="-2,-4,0,-4"/>
                                        <TextBlock x:Name="TimerInfo" FontSize="11" Foreground="{StaticResource Dim}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="TimerMinus" Style="{StaticResource IconBtn}" Content="&#xE738;" Tag="-1" Click="TimerAdjust_Click"/>
                                        <Button x:Name="TimerPlus" Style="{StaticResource IconBtn}" Content="&#xE710;" Tag="1" Click="TimerAdjust_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="TimerPlay" Style="{StaticResource PrimaryBtn}" Width="48" Height="48" FontSize="18" Content="&#xE768;" Click="TimerPlay_Click"/>
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" Click="TimerReset_Click" Margin="8,0,0,0"/>
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Click="TimerSkip_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Tarefas -->
                                <Grid x:Name="TodoPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBox x:Name="TodoInput" Style="{StaticResource DarkBox}"
                                                 PreviewMouseDown="Input_PreviewMouseDown" KeyDown="TodoInput_KeyDown"
                                                 TextChanged="TodoInput_TextChanged"/>
                                        <TextBlock x:Name="TodoHint" Text="{DynamicResource L.todo.hint}" IsHitTestVisible="False"
                                                   Margin="12,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Faint}"/>
                                        <Button Style="{StaticResource IconBtn}" Width="28" Height="28" FontSize="12" Content="&#xE710;"
                                                HorizontalAlignment="Right" Margin="0,0,2,0" Click="TodoAdd_Click"/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Hidden">
                                        <ItemsControl x:Name="TodoList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Style="{StaticResource RoundCheck}" IsChecked="{Binding Done, Mode=TwoWay}"
                                                                  Click="TodoCheck_Click" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Margin="10,0" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.4"/>
                                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Icons}" FontFamily="{StaticResource Icons}" FontSize="11"
                                                                       Foreground="#FFFFB020" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding DueLabel}" FontSize="11" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="3" Style="{StaticResource IconBtn}" Width="24" Height="24" FontSize="9"
                                                                Content="&#xE711;" Tag="{Binding}" Click="TodoDelete_Click" Margin="6,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="TodoEmpty" Grid.Row="1" Text="{DynamicResource L.todo.empty}" FontSize="12"
                                               Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Prateleira de arquivos -->
                                <Grid x:Name="ShelfPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                        <ItemsControl x:Name="ShelfList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ShelfTile}" Width="72" Height="74" Margin="1" CornerRadius="10"
                                                            Cursor="Hand" Tag="{Binding}"
                                                            MouseLeftButtonDown="ShelfItem_MouseDown" MouseMove="ShelfItem_MouseMove"
                                                            MouseLeftButtonUp="ShelfItem_MouseUp" MouseRightButtonUp="ShelfItem_RightClick">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <Image Source="{Binding Icon}" Width="32" Height="32"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                                       TextAlignment="Center" Margin="4,6,4,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel x:Name="ShelfEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource L.shelf.empty}" FontSize="12" Margin="0,10,0,0" Foreground="{StaticResource Dim}"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <TextBlock Text="{DynamicResource L.shelf.hint}" FontSize="10"
                                                   Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource TextBtn}" Content="{DynamicResource L.shelf.clear}" HorizontalAlignment="Right" Click="ShelfClear_Click"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ===== ALARME TOCANDO ===== -->
                    <Grid x:Name="AlarmPanel" Background="Black" Visibility="Collapsed">
                        <Grid Margin="26,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7ED;" FontFamily="{StaticResource Icons}" FontSize="44" Foreground="#FFFFB020"
                                       VerticalAlignment="Center" Margin="0,0,22,0">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.5"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="AlarmTime" FontSize="44" FontWeight="Light" FontFamily="Segoe UI Variable Display, Segoe UI" Margin="0,-6,0,-4"/>
                                <TextBlock x:Name="AlarmText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource AccentTextBtn}" Content="{DynamicResource L.alarm.stop}" FontSize="13" Padding="22,8" Click="AlarmStop_Click"/>
                                    <Button Style="{StaticResource TextBtn}" Content="{DynamicResource L.alarm.snooze}" FontSize="13" Padding="18,8" Margin="10,0,0,0" Click="AlarmSnooze_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border x:Name="DropRing" BorderBrush="#FF0A84FF" BorderThickness="2" CornerRadius="17"
                            IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
